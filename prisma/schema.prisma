generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  password         String
  role             Role          @default(CUSTOMER)
  isVerified       Boolean       @default(false)
  isActive         Boolean       @default(true)
  refreshTokenHash String?
  otpCodeHash      String?
  otpExpiresAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orders           Order[]
  createdProducts  Product[]
  reviews          Review[]
  reviewTokens     ReviewToken[]
  cart             Cart?
  wishlist         Wishlist?
  couponUsages     CouponUsage[]
}

model Product {
  id                String          @id @default(cuid())
  title             String
  shortDescription  String
  description       String
  category          String?
  categoryId        String?
  costPrice         Float
  customerSellPrice Float
  customerSpecialPrice Float?
  resellerPrice     Float
  resellerSellPrice Float?
  resellerSpecialPrice Float?
  salePrice         Float?
  discountType      DiscountType?
  discountValue     Float?
  taxRate           Float?
  couponCode        String?
  status            ProductStatus   @default(DRAFT)
  thumbnailImage    String
  productImages     String[]
  isFeatured        Boolean         @default(false)
  specialSaleEnabled Boolean        @default(false)
  discountEnabled   Boolean        @default(false)
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  productVideos     String[]        @default([])
  slug              String          @unique
  productCode       String          @unique
  barcode           String?         @unique
  attributes        Json            @default("[]")
  orderItems        OrderItem[]
  createdBy         User?           @relation(fields: [createdById], references: [id])
  categoryRel       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews           ProductReview[]
  legacyReviews     Review[]
  reviewTokens      ReviewToken[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  couponProducts    CouponProduct[]

  @@index([categoryId])
  @@index([status])
  @@index([status, createdAt])
}

model Category {
  id                 String         @id @default(cuid())
  name               String         @unique
  slug               String         @unique
  description        String?
  image              String?
  parentCategoryId   String?
  discountPercentage Float          @default(0)
  discountEnabled    Boolean        @default(false)
  sortOrder          Int            @default(0)
  showOnHomepage     Boolean        @default(false)
  status             CategoryStatus @default(ACTIVE)
  metaTitle          String?
  metaDescription    String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  parentCategory Category?  @relation("CategoryToParent", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories  Category[] @relation("CategoryToParent")
  products       Product[]

  @@index([status, deletedAt])
  @@index([parentCategoryId])
}

model Cart {
  id              String     @id @default(cuid())
  userId          String     @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           CartItem[]
  appliedCouponId String?
  appliedCoupon   Coupon?    @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)

  @@index([appliedCouponId])
}

model ShippingMethod {
  id                    String               @id @default(cuid())
  name                  String               @unique
  charge                Float
  estimatedDeliveryDays Int
  description           String?
  status                ShippingMethodStatus @default(ACTIVE)
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  orders                Order[]

  @@index([status, deletedAt])
}

model Coupon {
  id                 String          @id @default(cuid())
  code               String          @unique
  description        String?
  discountType       DiscountType
  discountValue      Float
  scope              CouponScope     @default(ENTIRE_ORDER)
  categories         String[]        @default([])
  startsAt           DateTime
  expiresAt          DateTime
  maximumUsage       Int?
  perUserUsageLimit  Int?
  minimumOrderAmount Float?
  maximumDiscount    Float?
  isActive           Boolean         @default(true)
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  products           CouponProduct[]
  usages             CouponUsage[]
  orders             Order[]
  carts              Cart[]

  @@index([isActive, startsAt, expiresAt, deletedAt])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String?
  orderId        String   @unique
  discountAmount Float
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model AppSetting {
  id                         String   @id @default(cuid())

  // General Settings
  storeName                  String   @default("GrowthZen Store")
  companyName                String   @default("GrowthZen Inc.")
  storeLogo                  String?
  favicon                    String?
  supportEmail               String   @default("support@growthzen.com")
  supportPhone               String   @default("+8801700000000")
  companyAddress             String   @default("Dhaka, Bangladesh")
  currency                   String   @default("BDT")
  currencySymbol             String   @default("৳")
  timezone                   String   @default("Asia/Dhaka")
  language                   String   @default("en")

  // Delivery Settings
  deliveryEnabled            Boolean  @default(true)
  freeDeliveryEnabled        Boolean  @default(false)
  insideDhakaDeliveryCharge  Float    @default(60)
  outsideDhakaDeliveryCharge Float    @default(120)
  freeShippingMinOrderAmount Float    @default(0)
  estimatedDeliveryDays      Int      @default(3)

  // Payment Settings
  codEnabled                 Boolean  @default(true)
  bkashEnabled               Boolean  @default(true)
  nagadEnabled               Boolean  @default(true)
  merchantName               String?  @default("GrowthZen Merchant")
  merchantNumber             String?  @default("01700000000")
  paymentInstructions        String?  @default("Please send exact amount to merchant number and provide Transaction ID.")

  // SMTP Settings
  smtpHost                   String?  @default("smtp.mailtrap.io")
  smtpPort                   Int?     @default(587)
  smtpUsername               String?
  smtpPassword               String?
  senderName                 String?  @default("GrowthZen Ecommerce")
  senderEmail                String?  @default("noreply@growthzen.com")

  // Maintenance Settings
  maintenanceMode            Boolean  @default(false)
  maintenanceMessage         String?  @default("Store is currently under scheduled maintenance. Please try again later.")

  // Legacy fields kept for backward compatibility
  customerDiscountPercentage Int      @default(0)
  couponCode                 String?
  couponActive               Boolean  @default(false)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Banner {
  id           String    @id @default(cuid())
  title        String?
  subtitle     String?
  description  String?
  image        String
  buttonText   String?
  buttonUrl    String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, deletedAt, displayOrder])
}

model Order {
  id                    String               @id @default(cuid())
  orderCode             String               @unique
  userId                String?
  userEmail             String?
  customerEmail         String?
  paymentMethod         PaymentMethod        @default(COD)
  guestName             String?
  guestPhone            String?
  guestEmail            String?
  guestAddress          String?
  guestDivision         String?
  guestDistrict         String?
  guestUpazila          String?
  shippingType          String?
  orderNotes            String?
  orderedByRole         Role                 @default(CUSTOMER)
  customerName          String
  customerPhone         String
  address               String
  deliveryArea          DeliveryArea
  subtotal              Float
  discountAmount        Float
  deliveryCharge        Float
  payableAmount         Float
  originalSubtotal      Float                @default(0)
  productDiscount       Float                @default(0)
  categoryDiscount      Float                @default(0)
  specialDiscount       Float                @default(0)
  couponDiscount        Float                @default(0)
  shippingCharge        Float                @default(0)
  taxAmount             Float                @default(0)
  grandTotal            Float                @default(0)
  totalSavings          Float                @default(0)
  finalPayable          Float                @default(0)
  couponCode            String?
  status                OrderStatus          @default(PENDING)
  paymentCollected      Boolean              @default(true)
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  deliveredAt           DateTime?
  adminNote             String?
  idempotencyKey        String?              @unique
  shippingMethodId      String?
  shippingMethodName    String?
  estimatedDeliveryDate DateTime?
  trackingNumber        String?
  courierName           String?
  deliveryStatus        DeliveryStatus       @default(PENDING)
  couponId              String?
  courierServiceCost    Float?
  deliveryProfit        Float?
  productCost           Float?
  grossSales            Float?
  netProfit             Float?
  customerPaid          Float?
  productSellingTotal   Float?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User?                @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  reviews               Review[]
  reviewTokens          ReviewToken[]
  payment               Payment?
  statusHistory         OrderStatusHistory[]
  shippingMethod        ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  coupon                Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage           CouponUsage?
  invoice               Invoice?

  @@index([userId, status, createdAt])
  @@index([orderCode])
  @@index([shippingMethodId])
  @@index([couponId])
  @@index([deliveryStatus])
  @@index([guestPhone])
  @@index([guestEmail])
  @@index([customerPhone])
}

model Invoice {
  id                String   @id @default(cuid())
  invoiceNumber     String   @unique
  orderId           String   @unique
  verificationToken String   @unique
  invoiceDate       DateTime @default(now())

  // Snapshot details
  orderNumber       String
  orderDate         DateTime
  paymentMethod     String
  paymentStatus     String
  orderStatus       String

  // Customer snapshot
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerRole      String?

  // Shipping snapshot
  shippingAddress   String?
  shippingDistrict  String?
  shippingDivision  String?
  shippingType      String?
  shippingArea      String?

  // Products snapshot
  productsJson      Json

  // Accounting snapshot
  subtotal          Float
  discount          Float
  deliveryCharge    Float
  grandTotal        Float
  productCost       Float
  courierCost       Float
  courierProfit     Float
  netProfit         Float

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([verificationToken])
  @@index([invoiceNumber])
  @@index([orderId])
}

model OrderStatusHistory {
  id             String      @id @default(cuid())
  orderId        String
  previousStatus        OrderStatus
  newStatus             OrderStatus
  previousPaymentStatus PaymentStatus?
  newPaymentStatus      PaymentStatus?
  changedById           String?
  adminNote      String?
  createdAt      DateTime    @default(now())
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  senderNumber    String?
  transactionId   String?       @unique
  paidAmount      Float?
  screenshot      String?
  rejectionReason String?
  refundReason    String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  productId      String
  productCode    String
  quantity       Int
  size           String?
  unitPrice      Float
  baseUnitPrice  Float?
  purchaseCost   Float        @default(0)
  discountAmount Float        @default(0)
  totalPrice     Float
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  review         Review?
  reviewToken    ReviewToken?
}

model Review {
  id                 String       @id @default(cuid())
  productId          String?
  orderId            String?
  orderItemId        String?      @unique
  userId             String?
  reviewerName       String?
  reviewerEmail      String?
  rating             Int
  title              String?
  comment            String?
  images             String[]     @default([])
  source             ReviewSource @default(PUBLIC)
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  products  ProductReview[]
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([source])
}

model ProductReview {
  productId String
  reviewId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([productId, reviewId])
  @@index([reviewId])
  @@index([productId])
}

model ReviewToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  orderId       String
  orderItemId   String    @unique
  productId     String
  userId        String?
  customerEmail String?
  expiresAt     DateTime
  isUsed        Boolean   @default(false)
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([orderId])
  @@index([expiresAt])
}

enum Role {
  ADMIN
  RESELLER
  CUSTOMER
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  CANCELLED
  DELIVERED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ShippingMethodStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryStatus {
  PENDING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

enum CouponScope {
  ENTIRE_ORDER
  SPECIFIC_PRODUCT
  SPECIFIC_CATEGORY
}

enum DeliveryArea {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum ReviewSource {
  VERIFIED_PURCHASE
  PUBLIC
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  APPROVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ContactMessageStatus {
  UNREAD
  READ
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(UNREAD)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}


